import { Form, Input, Modal } from 'antd'

/**
 * 新建项目弹窗。
 * 只负责收集表单值，实体怎么造（id、创建日期）交给 store 的工厂函数。
 */
export default function ProjectCreateModal({ open, onCancel, onSubmit }) {
  const [form] = Form.useForm()

  const handleCancel = () => {
    form.resetFields()
    onCancel()
  }

  const handleFinish = (values) => {
    onSubmit(values)
    form.resetFields()
    onCancel()
  }

  return (
    <Modal
      title="新建教学实训项目"
      open={open}
      onCancel={handleCancel}
      onOk={() => form.submit()}
      okText="创建"
      cancelText="取消"
    >
      <Form form={form} onFinish={handleFinish} layout="vertical">
        <Form.Item
          name="name"
          label="项目名称"
          rules={[{ required: true, message: '请输入项目名称' }]}
        >
          <Input placeholder="例如：金融数据上链存证系统" />
        </Form.Item>
        <Form.Item
          name="course"
          label="课程名称"
          rules={[{ required: true, message: '请输入课程名称' }]}
        >
          <Input placeholder="例如：区块链技术原理及应用" />
        </Form.Item>
        <Form.Item
          name="description"
          label="项目简介"
          rules={[{ required: true, message: '请输入项目简介' }]}
        >
          <Input.TextArea rows={3} placeholder="简要描述项目的核心目标，技术栈或者成果要求" />
        </Form.Item>
      </Form>
    </Modal>
  )
}
