/* ============================================================
   projects.css — 项目页
   项目卡片、文件夹路径、详情抽屉
   ============================================================ */

/* ============================================================
   项目页
   ============================================================ */

.project-card-title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-desc {
  color: var(--text-2);
  font-size: 13px;
  line-height: 21px;
  min-height: 42px;
  margin: 0 0 12px 0;
}

.project-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
  font-size: 12px;
}

.project-date {
  color: var(--text-3);
  white-space: nowrap;
}

.project-progress-row {
  margin-bottom: 10px;
}

.project-progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: var(--text-3);
  margin-bottom: 2px;
}

.project-progress-label em {
  font-style: normal;
}

.project-folder {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text-3);
}

.project-folder-path {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 项目详情抽屉 */

.project-drawer .ant-drawer-body {
  padding: 18px 22px;
}

.drawer-footer {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

.detail-meta {
  background: var(--bg-subtle);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  margin-bottom: 14px;
}

.detail-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  font-size: 13px;
  padding: 4px 0;
}

.detail-meta-row > span {
  color: var(--text-3);
  flex: none;
}

.detail-meta-row > b {
  font-weight: 500;
  color: var(--text-1);
}

.detail-path {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-desc {
  color: var(--text-2);
  font-size: 13px;
  line-height: 1.7;
  margin: 0 0 16px;
}

.detail-progress {
  margin-bottom: 18px;
}

.detail-progress-head {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  color: var(--text-2);
  margin-bottom: 4px;
}

.detail-progress-head b {
  font-weight: 500;
  color: var(--text-1);
}

.detail-progress-head em {
  font-style: normal;
}

.detail-section-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 6px;
}

.detail-task {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
}

.detail-task:last-child {
  border-bottom: none;
}

.detail-task-main {
  flex: 1;
  min-width: 0;
}

.detail-task-title {
  font-size: 13.5px;
  color: var(--text-1);
  line-height: 1.5;
  word-break: break-word;
}

.detail-task-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 4px;
  font-size: 12px;
}

.detail-task-meta .ant-tag {
  margin-inline-end: 0;
}

.detail-task-date {
  color: var(--text-3);
  font-size: 12px;
}

.is-done {
  color: var(--text-3) !important;
  text-decoration: line-through;
}

